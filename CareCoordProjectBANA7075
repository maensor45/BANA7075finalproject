from pathlib import Path
import mlflow
import mlflow.pyfunc
import pandas as pd


# -------------------------------
# 1. Set MLflow tracking location
# -------------------------------
PROJECT_DIR = Path.cwd()
mlflow.set_tracking_uri(f"file:///{PROJECT_DIR.as_posix()}/mlruns")
mlflow.set_experiment("Patient Program Matching")


# -------------------------------
# 2. Define the MLflow model
# -------------------------------
class PatientProgramRecommender(mlflow.pyfunc.PythonModel):

    def load_context(self, context):
        self.programs = pd.read_csv(context.artifacts["programs_file"])

        # Normalize text columns
        text_cols = [
            "program_name",
            "location",
            "treatment_specialty",
            "primary_population",
            "program_type",
            "independence_focus",
        ]

        for col in text_cols:
            if col in self.programs.columns:
                self.programs[col] = (
                    self.programs[col].astype(str).str.strip().str.lower()
                )

    def _normalize_text(self, value):
        if pd.isna(value):
            return "unknown"
        return str(value).strip().lower()

    def predict(self, context, model_input: pd.DataFrame) -> pd.DataFrame:
        results_all = []

        for _, row in model_input.iterrows():
            patient = {k: self._normalize_text(v) for k, v in row.to_dict().items()}
            programs = self.programs.copy()

            programs["diagnosis_match"] = (
                programs["treatment_specialty"]
                == patient.get("primary_diagnosis", "unknown")
            ).astype(int)

            programs["focus_match"] = (
                programs["independence_focus"]
                == patient.get("transition_focus", "unknown")
            ).astype(int)

            programs["priority1_population_match"] = (
                programs["primary_population"]
                == patient.get("priority_1", "unknown")
            ).astype(int)

            programs["priority2_population_match"] = (
                programs["primary_population"]
                == patient.get("priority_2", "unknown")
            ).astype(int)

            programs["score"] = (
                3 * programs["diagnosis_match"]
                + 2 * programs["focus_match"]
                + 2 * programs["priority1_population_match"]
                + 1 * programs["priority2_population_match"]
            )

            top_program = programs.sort_values(
                by=["score", "continuum_score"],
                ascending=[False, False]
            ).iloc[0]

            results_all.append({
                "recommended_program": top_program["program_name"],
                "location": top_program["location"],
                "program_type": top_program["program_type"],
                "score": float(top_program["score"]),
            })

        return pd.DataFrame(results_all)


# -------------------------------
# 3. Log model to MLflow
# -------------------------------
with mlflow.start_run():
    mlflow.pyfunc.log_model(
        name="patient_program_model",
        python_model=PatientProgramRecommender(),
        artifacts={
            "programs_file": "data/processed/programs_clean.csv"
        },
        input_example=pd.DataFrame([{
            "age": 24.0,
            "primary_diagnosis": "anxiety",
            "priority_1": "young adult",
            "priority_2": "unknown",
            "transition_focus": "independent living",
            "coordinator_comfort": "high",
        }]),
    )

    run_id = mlflow.active_run().info.run_id

    print("✅ Model logged successfully")
    print(f"Run ID: {run_id}")
    print(f"Model URI: runs:/{run_id}/patient_program_model")

